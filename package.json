{
  "name": "solid-cljs",
  "scripts": {
    "test": "shadow-cljs compile test && node -C browser out/test.js",
    "test:watch": "shadow-cljs watch test",
    "example": "shadow-cljs watch app & vite",
    "release": "shadow-cljs release app && vite build",
    "vitest": "shadow-cljs compile vitest && vitest run --browser=chromium",
    "vitest:watch": "shadow-cljs watch vitest",
    "build-report": "shadow-cljs run shadow.cljs.build-report app public/report.html",
    "bench": "shadow-cljs release bench && vite build --config vite.bench.config.mjs && node dev/bench/run.mjs"
  },
  "dependencies": {
    "@solidjs/h": "^2.0.2",
    "@solidjs/web": "^2.0.3",
    "solid-js": "^2.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@solidjs/router": "^2.0.0",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/browser-preview": "^4.1.12",
    "jsdom": "^27.4.0",
    "playwright": "^1.65.1",
    "shadow-cljs": "^3.5.14",
    "vite": "^7.3.0",
    "vitest": "^4.1.12"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
