{:paths ["src" "resources"]
 :aliases
 {;; clojure -M:jvm-test: server functions on the JVM (solid.server-functions.ring)
  :jvm-test {:extra-paths ["test/jvm"]
             :extra-deps {org.clojure/clojure {:mvn/version "1.12.7"}
                          ring/ring-jetty-adapter {:mvn/version "1.15.6"}
                          org.slf4j/slf4j-nop {:mvn/version "2.0.17"}
                          io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
             :main-opts ["-m" "cognitect.test-runner" "-d" "test/jvm"]}
  :dev {:extra-paths ["dev"]
        :extra-deps {org.clojure/clojure {:mvn/version "1.12.0"}
                     org.clojure/clojurescript {:mvn/version "1.11.60"}}}
  :release {:extra-paths ["dev"]
            :extra-deps {appliedscience/deps-library {:mvn/version "0.3.4"}
                         org.apache.maven/maven-model {:mvn/version "3.6.3"}}
            :main-opts ["-m" "release"]}}}